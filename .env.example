# ==============================================================================
# PARTYSTREAM — BIẾN MÔI TRƯỜNG (ENVIRONMENT VARIABLES)
# Khuyến nghị:
# - Chạy Local: Sao chép file này thành .env.local
# - Deploy Vercel: Thêm các biến dưới đây vào mục Settings -> Environment Variables
# ==============================================================================

# 1. CẤU HÌNH SUPABASE (PostgreSQL BaaS)
# Lấy từ Supabase Project Dashboard -> Project Settings -> API
# Nếu để trống hoặc dùng giá trị mặc định, app sẽ tự động chạy ở chế độ Mock / LocalStorage.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 2. CẤU HÌNH ORACLE CLOUD (OCI) MEDIA STREAMING VPS (Tùy chọn ghi chú)
# Đường dẫn domain hoặc IP tĩnh của VPS Oracle Cloud chạy Nginx streaming video
VITE_ORACLE_VOD_BASE_URL="https://vod.yourcompany.vn"

# 3. MÃ PIN QUẢN TRỊ DEV PORTAL (Tùy chọn)
# Mặc định trong code là "admin2026", dùng để bảo vệ quyền thêm/sửa video và cấu hình hệ thống
VITE_ADMIN_PASSCODE="admin2026"
